# Environment variables for LendMatch (Phase 2)

# Hugging Face Prediction Endpoint (defaults to public hosted space if omitted)
HF_PREDICT_URL=https://jensbender-loan-default-prediction-app.hf.space/api/predict

# Optional: Hugging Face API key (only needed if using a gated or private endpoint)
# HF_API_KEY=hf_your_token_here

# Optional: Allowed CORS origins for FastAPI standalone backend
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
